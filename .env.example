# Copy this file to .env. Keep credentials out of source control.
OPENAI_API_KEY=
VAST_MODEL=gpt-4o-mini

# Chat accepts exactly 10 national digits (US/CA), with optional separators.
# Existing database/tool numbers retain their canonical international format.
VAST_PHONE_REGION=US

# Rolling booking window beginning today in the clinic timezone.
VAST_BOOKING_DAYS=14
# Optional fixed demo start (YYYY-MM-DD). Leave empty for live relative dates.
VAST_FIRST_DAY=

# Temporary trusted-demo mode: keep chat contact updates; do not send email.
# Contact details alone do NOT prove ownership. Do not use false with real
# patient data on a public deployment. Set true to restore email verification.
VAST_REQUIRE_EMAIL_VERIFICATION=false

# Required only when VAST_REQUIRE_EMAIL_VERIFICATION=true.
# STARTTLS is mandatory; this adapter is for a STARTTLS endpoint, normally 587.
VAST_SMTP_HOST=
VAST_SMTP_PORT=587
VAST_SMTP_FROM=
VAST_SMTP_USERNAME=
VAST_SMTP_PASSWORD=